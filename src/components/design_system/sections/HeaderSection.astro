---
import BrandMark from '../ui/BrandMark.astro'
import Button from '../ui/Button.astro'
import Container from '../ui/Container.astro'

interface NavItem {
  label: string
  href: string
}

interface ActionItem {
  label: string
  href: string
  variant?: 'primary' | 'secondary' | 'ghost' | 'inverse'
}

interface UserMenuItem {
  label: string
  href: string
  tone?: 'default' | 'danger'
}

interface Props {
  brandLabel?: string
  brandHref?: string
  brandLogoSrc?: string
  navItems?: NavItem[]
  actions?: ActionItem[]
  userMenuItems?: UserMenuItem[]
  avatarSrc?: string
  align?: 'left' | 'center'
  class?: string
}

const {
  brandLabel = 'Brand',
  brandHref = '#',
  brandLogoSrc,
  navItems = [],
  actions = [],
  userMenuItems = [],
  avatarSrc = '/assets/message-house/about/team-core/images/member-1.jpeg',
  align = 'left',
  class: className = '',
} = Astro.props
---

<header class:list={['header-shell', className]}>
  <Container>
    <div class:list={['header-shell__inner', `header-shell__inner--${align}`]}>
      <div class="header-shell__brand">
        <slot name="brand">
          <BrandMark href={brandHref} label={brandLabel} logoSrc={brandLogoSrc} />
        </slot>
      </div>

      {navItems.length > 0 && (
        <nav class="header-shell__nav" aria-label="Primary">
          <ul class="nav-list">
            {navItems.map((item) => (
              <li><a class="nav-link" href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <div class="header-shell__actions">
        {actions.map((action) => (
          <Button href={action.href} variant={action.variant ?? 'secondary'} size="sm">
            {action.label}
          </Button>
        ))}

        {userMenuItems.length > 0 && (
          <div class="user-menu">
            <button type="button" class="user-menu__trigger">
              <span class="sr-only">Open user menu</span>
              <img src={avatarSrc} alt="" loading="lazy" />
            </button>

            <div class="user-menu__panel" role="menu" aria-label="User menu">
              {userMenuItems.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    'user-menu__link',
                    item.tone === 'danger' && 'user-menu__link--danger',
                  ]}
                  role="menuitem"
                >
                  {item.label}
                </a>
              ))}
            </div>
          </div>
        )}

        <button type="button" class="header-shell__toggle">
          <span class="sr-only">Toggle menu</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </Container>
</header>
