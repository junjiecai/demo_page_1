---
import CTASection from '../sections/CTASection.astro'
---

<CTASection
  eyebrow="Call to action"
  title="A contrast panel plus image mosaic for late-page conversion."
  summary="Use this when the section needs to feel more substantial and the supporting images help validate the offer."
  primaryAction={{ label: 'Get started today', href: '#' }}
  secondaryAction={{ label: 'Browse examples', href: '#' }}
  layout="panel-mosaic"
  mosaicImages={[
    {
      src: '/assets/evidence/deliverables/sample-shap.png',
      alt: 'SHAP 解释示例',
    },
    {
      src: '/assets/evidence/deliverables/sample-roc-mini.png',
      alt: 'ROC 结果示例',
    },
  ]}
/>
