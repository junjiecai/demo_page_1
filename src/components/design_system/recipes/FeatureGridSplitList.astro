---
import FeatureGridSection from '../sections/FeatureGridSection.astro'

const iconChart = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h16.5m0 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" /></svg>`
const iconPeople = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198A11.944 11.944 0 0 1 12 21a11.944 11.944 0 0 1-5.999-1.584m12 0a5.971 5.971 0 0 0-.941-3.197M17.06 15.522A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72A8.986 8.986 0 0 0 6 18.719m.94-3.197A5.971 5.971 0 0 0 6 18.719M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" /></svg>`
const iconConnect = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3m3 3a3 3 0 1 0 0 6h13.5a3 3 0 1 0 0-6m-16.5-3a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3m-19.5 0a4.5 4.5 0 0 1 .9-2.7L5.737 5.1a3.375 3.375 0 0 1 2.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 0 1 .9 2.7" /></svg>`

const items = [
  {
    title: 'Advanced reporting',
    description: 'Make leadership updates and stakeholder reviews easier to scan and trust.',
    icon: iconChart,
  },
  {
    title: 'Collaboration built in',
    description: 'Give product, growth, and customer teams a single narrative instead of parallel decks.',
    icon: iconPeople,
  },
  {
    title: 'Connector-ready',
    description: 'Slot this block into broader landing pages without inventing a new layout each time.',
    icon: iconConnect,
  },
]
---

<FeatureGridSection
  eyebrow="Feature grid"
  title="A split hero-plus-list pattern for more detailed value stories."
  summary="Use this when the page needs a stronger narrative on the left and a denser set of supporting points on the right."
  items={items}
  layout="split-list"
/>
