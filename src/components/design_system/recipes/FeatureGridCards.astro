---
import FeatureGridSection from '../sections/FeatureGridSection.astro'

const iconBolt = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" /></svg>`
const iconShield = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>`
const iconSliders = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 13.5V3.75m0 9.75a1.5 1.5 0 1 1 0 3m0-3a1.5 1.5 0 0 0 0 3m0 3.75V16.5m12-3V3.75m0 9.75a1.5 1.5 0 1 1 0 3m0-3a1.5 1.5 0 0 0 0 3m0 3.75V16.5m-6-9V3.75m0 3.75a1.5 1.5 0 1 1 0 3m0-3a1.5 1.5 0 0 0 0 3m0 9.75V10.5" /></svg>`

const items = [
  {
    title: '问题定义清晰',
    description: '用更少的视觉噪音，让研究目标、服务边界和交付方式在首屏就读得明白。',
    icon: iconBolt,
  },
  {
    title: '证据展示可读',
    description: '报告截图、图谱和案例示意优先放大呈现，建立可信度，而不是沦为装饰背景。',
    icon: iconShield,
  },
  {
    title: '组件复用稳定',
    description: '主题、版式和 CTA 的约束先被固化，后续页面只做装配，不重复造轮子。',
    icon: iconSliders,
  },
]
---

<FeatureGridSection
  eyebrow="能力表达"
  title="三列价值点应该先交代可信度，再交代动作。"
  summary="这类模块适合承接首屏后的核心能力说明，用来验证标题体量、图标密度和卡片层级。"
  items={items}
  layout="cards"
/>
