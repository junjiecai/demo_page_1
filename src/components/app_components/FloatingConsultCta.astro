---
import Button from '../design_system/ui/Button.astro'
import Text from '../design_system/ui/Text.astro'

interface FloatingAsset {
  url: string
  alt: string
}

interface Props {
  label: string
  supportingText?: string
  summary: string
  href: string
  previewAsset?: FloatingAsset
}

const { label, supportingText, summary, href, previewAsset } = Astro.props
---

<aside class="app-floating-cta" aria-label={label}>
  <div class="app-floating-cta__top">
    <div>
      {supportingText && <Text as="p" tone="kicker">{supportingText}</Text>}
      <h2 class="app-floating-cta__title">{label}</h2>
      <p class="app-floating-cta__summary">{summary}</p>
    </div>

    {previewAsset && (
      <div class="app-floating-cta__thumb">
        <img src={previewAsset.url} alt={previewAsset.alt} loading="lazy" />
      </div>
    )}
  </div>

  <Button href={href}>{label}</Button>
</aside>
